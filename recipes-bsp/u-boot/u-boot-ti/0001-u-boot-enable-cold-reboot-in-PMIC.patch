From 1a638a83438eb89d9197874a68446f092dc5b06b Mon Sep 17 00:00:00 2001
From: Alexander Bauer <a.bauer@phytec.de>
Date: Tue, 10 Jun 2025 12:44:07 +0200
Subject: [PATCH] u-boot-enable-cold-reboot-in-PMIC

Signed-off-by: Alexander Bauer <a.bauer@phytec.de>
---
 board/phytec/phycore_am62x/phycore-am62x.c | 56 ++++++++++++++++++++++
 1 file changed, 56 insertions(+)

diff --git a/board/phytec/phycore_am62x/phycore-am62x.c b/board/phytec/phycore_am62x/phycore-am62x.c
index eee81eedde..f712cc07f0 100644
--- a/board/phytec/phycore_am62x/phycore-am62x.c
+++ b/board/phytec/phycore_am62x/phycore-am62x.c
@@ -27,6 +27,12 @@ DECLARE_GLOBAL_DATA_PTR;
 #define EEPROM_ADDR             0x50
 #define EEPROM_ADDR_FALLBACK    -1
 
+#define PMIC_BUS		0x0
+#define PMIC_ADDR		0x30
+#define MFP_2_CONFIG 		0x20
+#define WARM_COLD_RESET_CONFIG  (1 << 6)
+
+
 #define AM6X_DISABLE_ETH_PHY_OVERLAY "k3-am6-phycore-disable-eth-phy.dtbo"
 #define AM6X_DISABLE_SPI_NOR_OVERLAY "k3-am6-phycore-disable-spi-nor.dtbo"
 #define AM6X_DISABLE_RTC_OVERLAY "k3-am6-phycore-disable-rtc.dtbo"
@@ -465,6 +471,8 @@ enum env_location env_get_location(enum env_operation op, int prio)
 #if IS_ENABLED(CONFIG_BOARD_LATE_INIT)
 int board_late_init(void)
 {
+	int result;
+
 	u32 boot_device = get_boot_device();
 
 	switch (boot_device) {
@@ -505,6 +513,10 @@ int board_late_init(void)
 		}
 	}
 
+	result = board_pmic_set_hw_reset();
+	if (result)
+		return result;
+
 	return 0;
 }
 #endif
@@ -574,3 +586,47 @@ int board_fix_fdt(void *blob)
 	return qspi_fixup(NULL, &data);
 }
 #endif
+
+int board_pmic_set_hw_reset()
+{
+#if CONFIG_IS_ENABLED(DM_I2C)
+	struct udevice *dev;
+	u8 ret, data;
+	int bus_num = PMIC_BUS;
+	int addr = PMIC_ADDR;
+	int offset = MFP_2_CONFIG;
+
+	ret = i2c_get_chip_for_busnum(bus_num, addr, 1, &dev);
+	if (ret) {
+		pr_err("%s: i2c PMIC not found: %i.\n", __func__, ret);
+		return ret;
+	}
+
+	ret = dm_i2c_read(dev, offset, &data, 1);
+	if (ret) {
+		pr_err("%s: Unable to read PMIC reg: %i\n", __func__, ret);
+		return ret;
+	}
+
+	if (ret)
+		return ret;
+
+	data &= ~WARM_COLD_RESET_CONFIG;
+
+	ret = dm_i2c_write(dev, offset, &data, 1);
+
+	if (ret) {
+		pr_err("%s: Unable to write PMIC reg: %i\n", __func__, ret);
+		return ret;
+	}
+#else
+	i2c_set_bus_num(bus_num);
+	ret = i2c_read(addr, offset, 2, &data, 1);
+
+	data &= ~WARM_COLD_RESET_CONFIG;
+
+	ret = dm_i2c_write(dev, offset, &data, 1);
+
+#endif
+	return ret;
+}
